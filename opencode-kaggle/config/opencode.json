{
  "$schema": "https://opencode.ai/config.json",
  "model": "kaggle/__MODEL__",
  "compaction": { "auto": true, "buffer": "20%" },
  "providers": {
    "kaggle": {
      "name": "Kaggle (endpoint compatible con OpenAI)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "__BASE_URL__",
        "apiKey": "{file:__API_KEY_FILE__}"
      },
      "models": {
        "__MODEL__": {
          "name": "__MODEL__",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "compatibility": {
            "maxTokensField": "max_tokens",
            "streamUsage": true
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  }
}
